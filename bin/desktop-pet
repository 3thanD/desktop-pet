        return 0
    v = args[0].strip().rstrip("%")
    if v not in ("50", "100", "200"):
        err("size must be 50, 100 or 200 (percent)")
        return 2
    cfg["size"] = int(v)
    save_config(cfg)
    print("size set to " + acc(v + "%") + dim("  (2, 4 or 8 screen pixels per art pixel)"))
    return 0


def cmd_color(args):
    cfg = load_config()
    if not args:
        print("color: " + acc(str(cfg.get("color", "theme"))) + dim("  (theme | complement | custom #hex)"))
        return 0
    a = args[0].lower()
    if a == "custom":
        if len(args) < 2:
            err("usage: desktop-pet color custom '#rrggbb'")
            return 2
        a = args[1].lower()
    if re.fullmatch(r"#?[0-9a-f]{6}", a):
        a = "#" + a.lstrip("#")
    elif a not in ("theme", "complement"):
        err("color must be theme, complement or custom #rrggbb")
        return 2
    cfg["color"] = a
    save_config(cfg)
    swatch = bg(a, "  ") + " " if a.startswith("#") else ""
    print("color: " + swatch + acc(a))
    return 0


