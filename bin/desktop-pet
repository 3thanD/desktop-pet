# ------------------------------------------------------------------ skills

ORIGIN_LABEL = {"builtin": "built-in", "user": "yours", "pending": "pitched"}


def skills_reload():
    if is_on():
        ipc("skillsReload")


def onoff_txt(v):
    return fg(TC.get("green", "#8cc570"), "on ", True) if v else dim("off")


def cmd_skills(args):
    sub = args[0].lower() if args else "list"
    rest = args[1:]
    fn = {"list": skills_list, "review": skills_review, "enable": skills_enable, "disable": skills_disable,
          "on": skills_master, "off": skills_master, "pitch": skills_pitch, "remove": skills_remove,
          "run": skills_run, "preview": skills_run, "approve": skills_approve, "reject": skills_reject,
          "show": skills_show, "sound": skills_sound, "hoard-label": skills_hoard_label, "ids": skills_ids}.get(sub)
    if not fn:
        err("usage: desktop-pet skills [list|review|enable ID|disable ID|on|off|pitch|remove ID|run ID|show ID|"
            "approve ID|reject ID|sound on|off|hoard-label TEXT|off]")
        return 2
    return fn(rest if sub not in ("on", "off") else [sub])


def skills_ids(args):
    """Ids for tab completion: pending ones for approve/reject, user ones for remove."""
    skills, pending, _ = sk.discover()
    what = args[0] if args else ""
    if what in ("approve", "reject"):
        ids = [p["id"] for p in pending]
    elif what == "remove":
        ids = [x["id"] for x in skills if x["origin"] == "user"] + [p["id"] for p in pending]
    elif what in ("run", "preview", "show"):
        ids = [x["id"] for x in skills] + [p["id"] for p in pending]
    else:
        ids = [x["id"] for x in skills]
    print(" ".join(ids))
    return 0


def skills_list(_args):
    cfg = load_config()
    skills, pending, errors = sk.discover()
    master = cfg.get("skillsOn", True) is not False
    print(acc("Skills") + dim("   all skills: ") + onoff_txt(master).strip()
          + dim("   sounds: ") + ("on" if cfg.get("skillSound") is True else "off"))
    cur = cfg["pet"]
    for pet in PETS + ["any"]:
        mine = [x for x in skills if x["recipe"]["pet"] == pet]
        if not mine:
            continue
        print(("  " + acc(pet, False) if pet == cur else "  " + pet) + (dim("  (current pet)") if pet == cur else ""))
        for x in mine:
            r = x["recipe"]
            on = sk.is_enabled(cfg, x["id"], x["origin"])
            print("    %s %-16s %s %s" % (onoff_txt(on), x["id"], r["name"], dim("· " + ORIGIN_LABEL[x["origin"]])))
    if pending:
        print("  " + acc("pitched by your pet, waiting for you (%d)" % len(pending), False))
        for p in pending:
            print("    %s %-16s %s %s" % (fg(TC.get("yellow", "#e5c07b"), "new", True), p["id"], p["recipe"]["name"],
                                       dim("· " + p["pet"] + ' · "' + p["pitch"][:60] + '"')))
        print(dim("    review them: desktop-pet skills review"))
    for e in errors:
        print("  " + fg(TC.get("red", "#e05561"), "rejected ", True) + os.path.basename(e["file"]) + dim(" (" + e["origin"] + "): ")
              + e["errors"][0])
    print(dim("  user skills: %s   ·   desktop-pet skills enable|disable ID · review · pitch" % sk.USER_DIR.replace(HOME, "~")))
    return 0


def print_recipe(p_or_s, pitch=None):
    r = p_or_s["recipe"]
    print(acc(r["name"]) + dim("  (%s, %s skill)" % (r["id"], r["pet"])))
    if pitch:
        print("  " + fg(TC.get("yellow", "#e5c07b"), "pitch: ", True) + '"' + pitch + '"')
    if r.get("description"):
        print("  " + r["description"])
    for line in sk.describe(r):
        print("  " + (dim(line) if line.startswith(("touches", "everything")) else line))


def skills_show(args):
    if not args:
        err("usage: desktop-pet skills show ID")
        return 2
    skills, pending, _ = sk.discover()
    for x in skills + pending:
        if x["id"] == args[0]:
            print_recipe(x, x.get("pitch"))
            print(dim(json.dumps(x["recipe"], indent=1)))
            return 0
    err("no skill '%s'" % args[0])
    return 1


def skills_review(args):
    pending = sk.discover()[1]
    if not pending:
        print("No pitched skills waiting. " + dim("(your pet pitches at most one a day with the brain on; or: desktop-pet skills pitch)"))
        return 0
    interactive = sys.stdin.isatty() and "--list" not in args
    for i, p in enumerate(pending):
        print()
        print(dim("[%d/%d] " % (i + 1, len(pending))), end="")
        print_recipe(p, p["pitch"])
        print(dim("  recipe:"))
        for line in json.dumps(p["recipe"], indent=1).splitlines():
            print(dim("    " + line))
        if not interactive:
            print(dim("  decide: desktop-pet skills preview|approve|reject " + p["id"]))
            continue
        while True:
            try:
                ans = input(acc("  [p]review once, [a]pprove, [r]eject, [s]kip, [q]uit? ", False)).strip().lower()
            except EOFError:
                ans = "q"
            if ans in ("p", "preview"):
                if p["pet"] != (live_status() or {}).get("pet"):
                    print(dim("  (preview runs on the %s; switch with: desktop-pet pick %s)" % (p["pet"], p["pet"])))
                skills_run([p["id"]])
                continue
            if ans in ("a", "approve"):
                skills_approve([p["id"]])
            elif ans in ("r", "reject"):
                skills_reject([p["id"]])
            elif ans in ("q", "quit"):
                return 0
            break
    return 0


def skills_approve(args):
    if not args:
        err("usage: desktop-pet skills approve ID")
        return 2
    ok, msg = sk.approve(args[0])
    if not ok:
        err(msg)
        return 1
    skills_reload()
    print(acc("✓") + " approved and enabled " + acc(msg) + dim("  (saved in %s)" % sk.USER_DIR.replace(HOME, "~")))
    return 0


def skills_reject(args):
    if not args:
        err("usage: desktop-pet skills reject ID")
        return 2
    ok, msg = sk.reject(args[0])
    if not ok:
        err(msg)
        return 1
    skills_reload()
    print("rejected " + msg + dim(" (deleted)"))
    return 0


def skills_known(sid):
    skills, pending, _ = sk.discover()
    return next((x for x in skills if x["id"] == sid), None)


def skills_enable(args, on=True):
    if not args:
        err("usage: desktop-pet skills %s ID" % ("enable" if on else "disable"))
        return 2
    x = skills_known(args[0])
    if not x:
        if sk.find_pending(args[0]):
            err("'%s' is still pending; review it first: desktop-pet skills review" % args[0])
        else:
            err("no skill '%s' (desktop-pet skills lists them)" % args[0])
        return 1
    cfg = load_config()
    cfg["skills"][x["id"]] = bool(on)
    save_config(cfg)
    print("skill %s: %s" % (acc(x["id"]), acc("on" if on else "off")))
    return 0


def skills_disable(args):
    return skills_enable(args, on=False)


def skills_master(args):
    on = args[0] == "on"
    cfg = load_config()
    cfg["skillsOn"] = on
    save_config(cfg)
    if not on:
        if is_on():
            ipc("heal")
        helper("restore-all")
    print("pet skills: " + acc("on" if on else "off") + ("" if on else dim("  (no skill activity at all; effects removed)")))
    return 0


def skills_sound(args):
