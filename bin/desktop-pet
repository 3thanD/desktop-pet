def cmd_buddy(args):
    cfg = load_config()
    if not args:
        hooked = any(has_block(p) for p in (BASHRC, ZSHRC))
        print("build buddy: " + acc("on" if cfg.get("buddy", True) else "off")
              + dim("   shell hook: ") + ("installed" if hooked else "not installed (desktop-pet setup --buddy)"))
        return 0
    if args[0] not in ("on", "off"):
        err("usage: desktop-pet buddy <on|off>")
        return 2
    cfg["buddy"] = args[0] == "on"
    save_config(cfg)
    print("build buddy: " + acc(args[0]))
    if cfg["buddy"] and not any(has_block(p) for p in (BASHRC, ZSHRC)):
        print(dim("  the shell hook isn't installed yet: desktop-pet setup --buddy"))
    return 0


EVO_PREVIEW = {
    1: ["   oo   ", "  obbo  ", "  oeeo  ", "   oo   "],
    2: ["    o   ", "  oooo  ", " obbbbo ", " obeebo ", "  oooo  "],
    3: ["    o   ", "  oooo  ", " oBbBbo ", "obeebbeo", "obbbbbbo", " oooooo "],
    4: [" y  o  y", "  oooo  ", " owwwwo ", "obeebbeo", "obbbbbbo", " oooooo "],
}


def cmd_evolve(args):
    if args and args[0] == "--debug-set":
        if len(args) < 2:
            err("usage: desktop-pet evolve --debug-set <1-4|baby|teen|adult|elder> [classic|cyber|chonk]")
            return 2
        st = args[1]
        st = str(STAGES.index(st)) if st in STAGES[1:] else st
        if not is_on():
            err("the pet is off")
            return 1
        print(ipc("evolveSet", st, args[2] if len(args) > 2 else "classic") or "?")
        return 0
    cfg = load_config()
    pet = cfg["pet"]
    st = live_status() or load_state()
    cur = st.get("stage", 1)
    cols = pet_colors(pet)
    print(acc("Evolution") + dim("  (%s, now: %s)" % (pet, st.get("stageName") or STAGES[cur])))
    rows = max(len(v) for v in EVO_PREVIEW.values())
    for r in range(rows):
        line = ""
        for stg in (1, 2, 3, 4):
            art = EVO_PREVIEW[stg]
            pad = rows - len(art)
            row = art[r - pad] if r >= pad else " " * 8
            cell = ""
            for ch in row:
                if ch == " " or not USE_COLOR:
                    cell += "  " if (ch == " " or USE_COLOR) else "██"
                else:
                    cell += bg({"o": "#333344", "b": cols["b"], "B": "#555566", "e": "#101018",
                                "w": "#ffffff", "y": cols["y"]}.get(ch, cols["b"]), "  ")
            line += cell + "   "
        print("  " + line)
    names = ["baby", "teen", "adult", "elder"]
    print("  " + "   ".join(("[" + n + "]" if i + 1 == cur else n).center(16) for i, n in enumerate(names)))
    print()
    print(dim("  teen:  2+ days old, 20+ meals, 2+ care days"))
    print(dim("  adult: 7+ days old, 70+ meals, 5+ care days; diet decides the form:"))
    print(dim("         mostly digits = cyber, vowel-heavy = chonk, otherwise classic"))
    print(dim("  elder: 30+ days old, 300+ meals, 20+ care days, and happy (rare)"))
    if st.get("meals") is not None:
        print(dim("  now:   %s days old, %s meals, %s care days" % (st.get("ageDays", 0), st.get("meals", 0), st.get("careDays", 0))))
    return 0


