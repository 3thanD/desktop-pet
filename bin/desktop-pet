#!/usr/bin/env -S python3 -I
"""desktop-pet: control the Omarchy desktop pet plugin (3thand.desktop-pet)."""
import json
import os
import re
import subprocess
import sys
import time

sys.dont_write_bytecode = True   # never write .pyc into the plugin dir (the shell would reload it)
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "scripts"))
import skills as sk  # noqa: E402  (recipes, validation, pitch queue)

HOME = os.path.expanduser("~")
PLUGIN_ID = "3thand.desktop-pet"
# The repo / plugin checkout this script lives in (works from the clone and via the ~/.local/bin link).
REPO_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
PLUGIN_DIR = os.path.join(HOME, ".config/omarchy/plugins", PLUGIN_ID)
HELPER = os.path.join(REPO_DIR, "scripts", "helper.py")
CONFIG = os.path.join(HOME, ".config/desktop-pet/config.json")
STATE_DIR = os.path.join(HOME, ".local/state/desktop-pet")
STATE = os.path.join(STATE_DIR, "state.json")
MEMORY = os.path.join(STATE_DIR, "memory.json")
SHELL_JSON = os.path.join(HOME, ".config/omarchy/shell.json")
COLORS = os.path.join(HOME, ".local/state/omarchy/current/theme/colors.toml")
THEME_NAME = os.path.join(HOME, ".local/state/omarchy/current/theme.name")

PETS = ["slime", "cat", "dragon", "goblin"]
PET_DESC = {
    "slime": "a cute, bubbly slime",
    "cat": "an aloof little cat",
    "dragon": "a baby dragon (breathes fire: text turns red)",
    "goblin": "a goblin that borrows your dock icons",
}
STAGES = ["", "baby", "teen", "adult", "elder"]
ACCESSORIES = ["shades", "visor", "retroshades", "glow", "crown", "leafhat", "pumpkin", "beanie",
               "mushroom", "halo", "flower", "bow", "moonstars", "scarf", "headband", "tie", "gem"]
THEME_ACC = {
    "hackerman": "shades+glow", "tokyo-night": "visor", "everforest": "leafhat", "nord": "scarf+snow",
    "catppuccin": "crown", "catppuccin-latte": "crown", "rose-pine": "moonstars", "gruvbox": "pumpkin",
    "matte-black": "bow (monochrome)", "vantablack": "bow (monochrome)", "white": "bow (monochrome)",
    "kanagawa": "headband", "last-horizon": "headband", "lumon": "tie", "lupine": "flower",
    "miasma": "mushroom", "osaka-jade": "gem", "retro-82": "retroshades", "ristretto": "beanie",
    "solitude": "moonstars", "aether": "halo", "ethereal": "halo", "flexoki-light": "flower",
}
CHATTY = ["off", "low", "normal", "high"]
DEFAULTS = {
    "pet": "slime", "names": {}, "accessory": "auto", "eat": True, "goblinSteal": True,
    "chatty": "low", "brain": True, "brainContext": False, "persona": {}, "themePets": {},
    "size": 100, "color": "theme", "fetch": True, "buddy": True,
    "skillsOn": True, "skills": {}, "skillSound": False, "hoardLabel": "",
}

# ------------------------------------------------------------------ colors

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def theme_colors():
    c = {}
    try:
        for line in open(COLORS):
            m = re.match(r'\s*([A-Za-z0-9_\-]+)\s*=\s*"(#[0-9a-fA-F]{6})', line)
            if m:
                c[m.group(1)] = m.group(2)
    except Exception:
        pass
    return c


TC = theme_colors()


def rgb(hexstr):
    h = hexstr.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def fg(hexstr, text, bold=False):
    if not USE_COLOR or not hexstr:
        return text
    r, g, b = rgb(hexstr)
    return "\x1b[%s38;2;%d;%d;%dm%s\x1b[0m" % ("1;" if bold else "", r, g, b, text)


def bg(hexstr, text):
    if not USE_COLOR or not hexstr:
        return text
    r, g, b = rgb(hexstr)
    return "\x1b[48;2;%d;%d;%dm%s\x1b[0m" % (r, g, b, text)


ACCENT = TC.get("accent", "#7aa2f7")
DIM = TC.get("dark_foreground") or TC.get("muted") or "#777777"


def acc(t, bold=True):
    return fg(ACCENT, t, bold)


def dim(t):
    return fg(DIM, t)


def err(msg):
    sys.stderr.write(fg(TC.get("red", "#e05561"), "desktop-pet: ", True) + msg + "\n")


# ------------------------------------------------------------------ files

def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG) as f:
            user = json.load(f)
        if isinstance(user, dict):
            cfg.update(user)
    except FileNotFoundError:
        pass
    except Exception as e:
        err("config file is not valid JSON (%s); using defaults" % e)
    for k in ("names", "persona", "themePets", "skills"):
        if not isinstance(cfg.get(k), dict):
            cfg[k] = {}
    return cfg


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=1)
        f.write("\n")
    os.replace(tmp, CONFIG)
    if is_on():
        ipc("reload")


def load_doc():
    """The pet's saved state (v2: one record per species). Never raises."""
    for path in (STATE, STATE + ".bak"):
        try:
            with open(path) as f:
                d = json.load(f)
            if isinstance(d, dict):
                return d
        except Exception:
            continue
    return {}


def save_doc(d):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE + ".tmp-cli"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=1)
    os.replace(tmp, STATE)


def load_state(pet=None):
    """Flat view of one pet's stats (for status when the pet is off)."""
    d = load_doc()
    pet = pet or load_config()["pet"]
    if d.get("version") == 2:
        r = dict((d.get("pets") or {}).get(pet) or {})
        r["pet"] = pet
        if not (d.get("pets") or {}).get(pet):
            r["egg"] = True
        if r.get("hatchedAt"):
            r["ageDays"] = int((time.time() * 1000 - r["hatchedAt"]) / 86400000)
        st = r.get("stage", 1)
        r["stageName"] = STAGES[st] + (" (%s)" % r.get("variant") if st == 3 and r.get("variant", "classic") != "classic" else "")
        return r
    return d   # old flat format


def pet_label(cfg, pet):
    return cfg["names"].get(pet) or ("your " + pet)


def theme_slug():
    try:
        return open(THEME_NAME).read().strip().lower().replace(" ", "-")
    except Exception:
        return ""


# ------------------------------------------------------------------ shell / plugin

def run(cmd, timeout=15):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip()
    except Exception as e:
        return 1, str(e)


# ================================================================== host integration
# Everything that depends on the Omarchy shell lives in this block: how the pet
# is switched on/off and how the CLI reaches the running pet (Quickshell IPC
# target "desktoppet"). Settings themselves go through config.json, which the
# pet watches, so they work without any of this. A future standalone mode only
# needs to replace these three functions.

def host_is_enabled():
    """Is the plugin enabled in the Omarchy shell? (third-party plugin ids are
    listed in ~/.config/omarchy/shell.json when enabled)"""
    try:
        with open(SHELL_JSON) as f:
            return PLUGIN_ID in json.dumps(json.load(f).get("plugins", []))
    except Exception:
        return ipc("ping") == "ok"   # fallback: the pet answers, so it runs


def host_set_enabled(on):
    """Enable/disable the plugin. Returns (ok, message)."""
    if on:
        run(["omarchy-shell", "shell", "rescanPlugins"])
        time.sleep(1)
    code, out = run(["omarchy", "plugin", "enable" if on else "disable", PLUGIN_ID])
    if code == 0:
        return True, out
    # fallback: talk to the shell directly
    code, out2 = run(["omarchy-shell", "shell", "setPluginEnabled", PLUGIN_ID, "true" if on else "false"])
    return code == 0, out or out2


def ipc(method, *args):
    """Call the running pet. Returns its reply or None."""
    cands = []
    if os.environ.get("DESKTOP_PET_QS_CONFIG"):   # a pet running in its own Quickshell instance
        cands.append(["quickshell", "ipc", "-p", os.environ["DESKTOP_PET_QS_CONFIG"], "call", "desktoppet", method, *args])
    for cmd in cands + [["omarchy-shell", "desktoppet", method, *args],
                ["quickshell", "ipc", "-p", os.path.join(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy"), "shell"),
                 "call", "desktoppet", method, *args]]:
        code, out = run(cmd, timeout=10)
        if code == 0:
            return out
    return None


is_on = host_is_enabled
# ==================================================================


def helper(*args, timeout=40):
    code, out = run(["python3", "-I", HELPER, *args], timeout=timeout)
    try:
        return json.loads(out.splitlines()[-1]) if out else {}
    except Exception:
        return {}


def live_status():
    if not is_on():
        return None
    out = ipc("status")
    try:
        return json.loads(out) if out else None
    except Exception:
        return None


# ------------------------------------------------------------------ previews

PREVIEW = {
    "slime": ["  .oooo.  ", " obbbbbbo ", "obebbbbebo", "obbbmmbbbo", " oooooooo "],
    "cat":   [" o      o ", " obooooobo", " obebbbebo", " obbbmbbbo", "  oo  oo  "],
    "dragon": [" y      y ", " obbbbbbo ", "WobebbebbW", "WWoyyyyoWW", "  oo  oo  "],
    "goblin": ["   occo   ", "oobbbbbboo", " obybbybo ", "  occcco  ", "  oo  oo  "],
}


def pet_colors(pet):
    a = TC.get("accent", "#7aa2f7")
    fgc = TC.get("foreground", "#dddddd")
    green = TC.get("green", "#8cc570")
    body = {"slime": a, "cat": fgc, "dragon": green, "goblin": TC.get("bright_green", green)}[pet]
    return {"b": body, "o": "#333344", "e": "#101018", "m": "#552233", "y": TC.get("yellow", "#e5c07b"),
            "W": TC.get("cyan", "#56b6c2"), "c": TC.get("brown", "#8a5a2b")}


def preview(pet):
    cols = pet_colors(pet)
    rows = []
    for line in PREVIEW[pet]:
        s = ""
        for ch in line:
            if ch == " " or not USE_COLOR:
                s += "  " if USE_COLOR else ("  " if ch == " " else "██")
            else:
                s += bg(cols.get(ch, cols["b"]), "  ")
        rows.append(s)
    return rows


# ------------------------------------------------------------------ commands

def bar(value, color, width=20):
    v = max(0, min(100, int(round(value or 0))))
    full = int(round(v / 100 * width))
    if USE_COLOR:
        return fg(color, "█" * full) + fg(DIM, "░" * (width - full)) + " %3d" % v
    return "#" * full + "." * (width - full) + " %3d" % v


def cmd_status(_args):
    cfg = load_config()
    on = is_on()
    st = live_status() or load_state()
    pet = st.get("pet") or cfg["pet"]
    name = pet_label(cfg, pet)
    onoff = fg(TC.get("green", "#8cc570"), "on", True) if on else fg(TC.get("red", "#e05561"), "off", True)
    if st.get("egg"):
        print(acc("an egg") + dim(" (a %s is about to hatch)   ·   " % pet) + onoff)
        print(dim("  try: ") + "desktop-pet name <name>" + dim(" · ") + "help")
        return 0
    age = st.get("ageDays")
    print(acc(name) + dim("  the ") + (str(st.get("stageName", "")) + " " if st.get("stageName") else "") + pet
          + (dim(", %s day%s old" % (age, "" if age == 1 else "s")) if age is not None else "")
          + dim("   ·   ") + onoff
          + (dim("   mood: ") + str(st.get("mood")) if on and st.get("mood") else ""))
    print("  hunger    " + bar(st.get("hunger", 80), TC.get("yellow", ACCENT)))
    print("  happiness " + bar(st.get("happiness", 80), TC.get("magenta", ACCENT)))
    print("  energy    " + bar(st.get("energy", 80), TC.get("cyan", ACCENT)))
    a = cfg["accessory"]
    slug = theme_slug()
    acc_txt = ("auto → " + THEME_ACC.get(slug, "bow")) if a == "auto" else a
    print(dim("  accessory ") + acc_txt + dim("   theme ") + (slug or "?"))
    flags = []
    if not cfg["eat"]:
        flags.append("eating text off")
    if pet == "goblin" and not cfg["goblinSteal"]:
        flags.append("dock stealing off")
    flags.append("brain " + ("on" if cfg["brain"] else "off") + ", chatty " + cfg["chatty"])
    if st.get("meals") is not None:
        flags.append("%s meals, %s care days" % (st.get("meals", 0), st.get("careDays", 0)))
    print(dim("  " + "  ·  ".join(flags)))
    print(dim("  try: ") + "desktop-pet pick cat" + dim(" · ") + "feed" + dim(" · ") + "say \"hi\"" + dim(" · ")
          + "off" + dim(" · ") + "help")
    return 0


def cmd_on(_args):
    if is_on():
        print(acc("●") + " already on")
        return 0
    if not os.path.isfile(os.path.join(PLUGIN_DIR, "manifest.json")):
        err("the plugin is not installed at %s. Install it with:\n  omarchy plugin add https://github.com/3thanD/desktop-pet.git --enable" % PLUGIN_DIR)
        return 1
    ok, out = host_set_enabled(True)
    if not ok:
        err("could not enable the plugin: " + out)
        return 1
    print(acc("●") + " desktop pet is " + acc("on"))
    return 0


def cmd_off(_args):
    if is_on():
        ipc("save")
        ok, out = host_set_enabled(False)
        if not ok:
            err("could not disable the plugin: " + out)
            return 1
    helper("restore-all")
    print(dim("○") + " desktop pet is off (all overlays and skills removed, dock and wallpaper restored)")
    return 0


def cmd_toggle(args):
    return cmd_off(args) if is_on() else cmd_on(args)


def valid_pet(p):
    p = (p or "").lower()
    if p in PETS:
        return p
    err("unknown pet '%s'. Choose one of: %s" % (p, ", ".join(PETS)))
    return None


def cmd_pick(args):
    if not args:
        err("usage: desktop-pet pick <%s>" % "|".join(PETS))
        return 2
    pet = valid_pet(args[0])
    if not pet:
        return 2
    cfg = load_config()
    cfg["pet"] = pet
    save_config(cfg)
    name = pet_label(cfg, pet)
    print("\n".join("  " + r for r in preview(pet)))
    print(acc(name) + " the " + pet + " is now your pet" + ("" if is_on() else dim("  (pet is off; run: desktop-pet on)")))
    slug = theme_slug()
    if cfg["themePets"].get(slug) and cfg["themePets"][slug] != pet:
        print(dim("  note: your theme-pet mapping shows %s on theme %s" % (cfg["themePets"][slug], slug)))
    return 0


def cmd_list(_args):
    cfg = load_config()
    cur = (live_status() or {}).get("pet") or cfg["pet"]
    for pet in PETS:
        rows = preview(pet)
        mark = acc("▶ ") if pet == cur else "  "
        name = pet_label(cfg, pet)
        for i, r in enumerate(rows):
            right = ""
            if i == 1:
                right = (acc(pet) if pet == cur else pet) + dim("  \"" + name + "\"")
            elif i == 2:
                right = dim(PET_DESC[pet])
            elif i == 3 and pet == cur:
                right = acc("(current)", False)
            print((mark if i == 2 else "  ") + r + "  " + right)
        print()
    return 0


def cmd_name(args):
    if not args:
        err("usage: desktop-pet name <name>")
        return 2
    name = " ".join(args).strip()[:24]
    name = re.sub(r"[\x00-\x1f\x7f]", "", name)
    cfg = load_config()
    pet = cfg["pet"]
    cfg["names"][pet] = name
    save_config(cfg)
    print("Your " + pet + " is now called " + acc(name))
    return 0


def cmd_feed(_args):
    if is_on():
        ipc("feed")
        print(acc("*") + " you tossed a berry treat")
    else:
        d, pet = load_doc(), load_config()["pet"]
        r = (d.get("pets") or {}).get(pet)
        if d.get("version") == 2 and r:
            r["hunger"] = min(100, float(r.get("hunger", 50)) + 20)
            save_doc(d)
            print("Fed (the pet is off, so it will enjoy it when it comes back).")
        else:
            print("Nothing to feed yet: the pet hasn't hatched.")
    return 0


def cmd_pet(_args):
    if not is_on():
        err("the pet is off")
        return 1
    ipc("pat")
    print(acc("♥") + " you petted " + pet_label(load_config(), load_config()["pet"]))
    return 0


def cmd_heal(_args):
    if is_on():
        ipc("heal")
    r = helper("restore-all")
    print(acc("✚") + " all eaten and burned text restored, skills stopped"
          + (", dock icons put back" if r.get("dock") else "") + (", wallpaper restored" if r.get("wallpaper") else ""))
    return 0


def cmd_accessory(args):
    cfg = load_config()
    if not args:
        print("accessory: " + acc(cfg["accessory"]))
        return 0
    a = args[0].lower()
    if a == "list":
        slug = theme_slug()
        print(acc("auto") + dim("  follow the theme (now: %s → %s)" % (slug or "?", THEME_ACC.get(slug, "bow"))))
        print(acc("none") + dim("  no accessory"))
        print("  ".join(ACCESSORIES))
        return 0
    if a not in ACCESSORIES and a not in ("auto", "none"):
        err("unknown accessory '%s'. Try: auto, none, %s" % (a, ", ".join(ACCESSORIES)))
        return 2
    cfg["accessory"] = a
    save_config(cfg)
    print("accessory set to " + acc(a))
    return 0


def on_off(args, usage):
    if not args or args[0].lower() not in ("on", "off"):
        err("usage: " + usage)
        return None
    return args[0].lower() == "on"


def cmd_eat(args):
    v = on_off(args, "desktop-pet eat <on|off>")
    if v is None:
        return 2
    cfg = load_config()
    cfg["eat"] = v
    save_config(cfg)
    print("eating terminal text: " + acc("on" if v else "off") + ("" if v else dim("  (it will snack on berries instead)")))
    return 0


def cmd_goblin_steal(args):
    v = on_off(args, "desktop-pet goblin-steal <on|off>")
    if v is None:
        return 2
    cfg = load_config()
    cfg["goblinSteal"] = v
    save_config(cfg)
    if not v:
        helper("dock-restore")
    print("goblin dock stealing: " + acc("on" if v else "off"))
    return 0


def cmd_chatty(args):
    if not args or args[0].lower() not in CHATTY:
        err("usage: desktop-pet chatty <%s>" % "|".join(CHATTY))
        return 2
    cfg = load_config()
    cfg["chatty"] = args[0].lower()
    save_config(cfg)
    print("chattiness: " + acc(cfg["chatty"]))
    return 0


def cmd_brain(args):
    cfg = load_config()
    if args and args[0].lower() == "context":
        v = on_off(args[1:], "desktop-pet brain context <on|off>")
        if v is None:
            return 2
        cfg["brainContext"] = v
        save_config(cfg)
        print("share focused window title with Claude: " + acc("on" if v else "off"))
        return 0
    if not args:
        print("brain: " + acc("on" if cfg["brain"] else "off") + dim("   context sharing: ") + ("on" if cfg["brainContext"] else "off"))
        return 0
    v = on_off(args, "desktop-pet brain <on|off> | brain context <on|off>")
    if v is None:
        return 2
    cfg["brain"] = v
    save_config(cfg)
    print("brain: " + acc("on" if v else "off") + ("" if v else dim("  (canned lines only, no Claude calls)")))
    return 0


def cmd_persona(args):
    cfg = load_config()
    pet = cfg["pet"]
    if not args:
        cur = cfg["persona"].get(pet)
        print(("custom persona for %s: " % pet) + (cur if cur else dim("(default)")))
        return 0
    if args[0] == "reset":
        cfg["persona"].pop(pet, None)
        save_config(cfg)
        print("persona for %s reset to default" % pet)
        return 0
    text = re.sub(r"[\x00-\x1f\x7f]", " ", " ".join(args)).strip()[:600]
    cfg["persona"][pet] = text
    save_config(cfg)
    print("persona for %s set" % pet)
    return 0


def cmd_theme_pet(args):
    cfg = load_config()
    if not args:
        tp = cfg["themePets"]
        if not tp:
            print(dim("no theme-pet mappings (the pet you pick is used on every theme)"))
        for k, v in sorted(tp.items()):
            print("  %s → %s" % (k, v))
        return 0
    if len(args) < 2:
        err("usage: desktop-pet theme-pet <theme> <pet|off>")
        return 2
    theme = " ".join(args[:-1]).strip().lower().replace(" ", "-").replace("_", "-")
    pet = args[-1].lower()
    if pet in ("off", "none", "clear"):
        cfg["themePets"].pop(theme, None)
        save_config(cfg)
        print("theme %s now uses your picked pet" % theme)
        return 0
    if not valid_pet(pet):
        return 2
    cfg["themePets"][theme] = pet
    save_config(cfg)
    print("on theme %s the pet will be the %s" % (acc(theme), acc(pet)))
    return 0


def pet_ctx():
    cfg = load_config()
    st = live_status() or load_state()
    pet = st.get("pet") or cfg["pet"]
    return {
        "pet": pet, "name": cfg["names"].get(pet, ""), "mood": st.get("mood", "content"), "stage": st.get("stageName", ""), "ageDays": st.get("ageDays", 0),
        "hunger": st.get("hunger", 70), "happiness": st.get("happiness", 70), "energy": st.get("energy", 70),
        "theme": theme_slug(), "accessory": st.get("accessory", ""),
    }


def speak(ctx, message, history=None):
    p = dict(ctx)
    p.update({"trigger": "chat" if history is not None else "say", "message": message})
    if history:
        p["history"] = history
    r = helper("talk", json.dumps(p), timeout=45)
    text = r.get("text") or "..."
    if is_on():
        ipc("bubble", text)
    return text, r.get("source", "canned")


def cmd_say(args):
    if not args:
        err('usage: desktop-pet say "<message>"')
        return 2
    ctx = pet_ctx()
    msg = " ".join(args)
    text, source = speak(ctx, msg)
    print(acc(ctx["name"] + ":") + " " + text + ("" if source == "claude" else dim("  (" + source + ")")))
    return 0


def cmd_chat(_args):
    ctx = pet_ctx()
    print(dim("Chatting with ") + acc(ctx["name"]) + dim(" (Ctrl-D to leave)"))
    history = []
    while True:
        try:
            msg = input(fg(TC.get("foreground", "#dddddd"), "you› ", True))
        except (EOFError, KeyboardInterrupt):
            print()
            break
        msg = msg.strip()
        if not msg:
            continue
        text, source = speak(ctx, msg, history)
        print(acc(ctx["name"] + "› ") + text + ("" if source == "claude" else dim("  (" + source + ")")))
        history += [{"who": "user", "text": msg}, {"who": "pet", "text": text}]
        history = history[-12:]
    return 0


def cmd_forget(_args):
    try:
        os.remove(MEMORY)
    except FileNotFoundError:
        pass
    print("memory cleared; %s forgot recent events and lines" % pet_ctx()["name"])
    return 0


