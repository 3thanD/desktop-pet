def skills_pitch(_args):
    cfg = load_config()
    if not cfg.get("brain", True):
        err("the brain is off; pitches need Claude (desktop-pet brain on)")
        return 1
    ctx = pet_ctx()
    print(dim("asking %s to think up a new trick (Claude, tools disabled)..." % (ctx["name"] or "your pet")))
    r = helper("skills-pitch", json.dumps(ctx), timeout=200)
    if not r.get("ok"):
        err(r.get("reason") or "no pitch this time")
        return 1
    skills_reload()
    if is_on():
        ipc("bubble", r.get("pitch") or "I have an idea!")
    print(acc((ctx["name"] or ctx["pet"]) + ":") + ' "' + (r.get("pitch") or "") + '"')
    print("  queued " + acc(r["id"]) + dim(" (%s); nothing runs until you approve it: desktop-pet skills review" % r.get("name", "")))
    return 0


# ------------------------------------------------------------------ setup / uninstall

BIN_LINK = os.path.join(HOME, ".local/bin/desktop-pet")
COMP_LINK = os.path.join(HOME, ".local/share/bash-completion/completions/desktop-pet")
CFG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
HYPR_LUA = os.path.join(CFG_HOME, "hypr/bindings.lua")
HYPR_CONF = os.path.join(CFG_HOME, "hypr/bindings.conf")
KITTY_CONF = os.path.join(CFG_HOME, "kitty/kitty.conf")
BASHRC = os.path.join(HOME, ".bashrc")
ZSHRC = os.path.join(os.environ.get("ZDOTDIR") or HOME, ".zshrc")
MARK_BEGIN = ">>> desktop-pet >>>"
MARK_END = "<<< desktop-pet <<<"
LUA_BLOCK = """
-- >>> desktop-pet >>>
-- SUPER+CTRL+P toggles the desktop pet. This replaces Omarchy's default
-- SUPER+CTRL+P binding (Power panel); the power menu stays on SUPER+ESCAPE.
hl.unbind("SUPER + CTRL + P")
o.bind("SUPER + CTRL + P", "Toggle desktop pet", os.getenv("HOME") .. "/.local/bin/desktop-pet toggle")
-- <<< desktop-pet <<<
"""
CONF_BLOCK = """
# >>> desktop-pet >>>
# SUPER+CTRL+P toggles the desktop pet (replaces any existing SUPER+CTRL+P binding).
unbind = SUPER CTRL, P
bindd = SUPER CTRL, P, Toggle desktop pet, exec, $HOME/.local/bin/desktop-pet toggle
# <<< desktop-pet <<<
"""
KITTY_BLOCK = """
# >>> desktop-pet >>>
# Local remote control so the desktop pet can read what's on screen (letters it
# eats). socket-only + a socket in your private runtime dir: only you can use it.
allow_remote_control socket-only
listen_on unix:${XDG_RUNTIME_DIR}/kitty
# <<< desktop-pet <<<
"""


def backup(path):
    if os.path.exists(path):
        dst = "%s.bak.desktop-pet.%d" % (path, int(time.time()))
        with open(path, "rb") as a, open(dst, "wb") as b:
            b.write(a.read())
        return dst
    return None


def has_block(path):
    try:
        return MARK_BEGIN in open(path).read()
    except OSError:
        return False


def strip_block(path):
    if not has_block(path):
        return False
    backup(path)
    s = open(path).read()
    s = re.sub(r"\n*[^\n]*" + re.escape(MARK_BEGIN) + r".*?" + re.escape(MARK_END) + r"[^\n]*\n?", "\n", s, flags=re.S)
    with open(path, "w") as f:
        f.write(s.rstrip("\n") + "\n")
    return True


def kitty_remote_ok():
    """Effective allow_remote_control / listen_on across kitty's config chain."""
    vals = {}
    for path in ("/etc/xdg/kitty/kitty.conf", KITTY_CONF):
        try:
            for line in open(path, errors="replace"):
                parts = line.strip().split(None, 1)
                if len(parts) == 2 and parts[0] in ("allow_remote_control", "listen_on"):
                    vals[parts[0]] = parts[1].strip()
        except OSError:
            pass
    arc = vals.get("allow_remote_control", "no").lower()
    return arc in ("yes", "y", "true", "socket", "socket-only", "password") and vals.get("listen_on", "").startswith("unix:")


def link_status(link, target):
    return os.path.islink(link) and os.path.realpath(link) == os.path.realpath(target)


def hypr_reload_ok():
    if run(["hyprctl", "reload"])[0] != 0:
        return True
    time.sleep(0.5)
    code, out = run(["hyprctl", "configerrors"])
    return not out.strip() or out.strip() == "no errors"


def buddy_block(kind):
    hook = os.path.join(REPO_DIR, "shell", "desktop-pet-buddy." + kind)
    return ("\n# >>> desktop-pet >>>\n# desktop-pet build buddy: records only command name, exit code and duration\n"
            "[ -f '%s' ] && . '%s'\n# <<< desktop-pet <<<\n" % (hook, hook))


def setup_plan(buddy=False):
    steps = []
    cli = os.path.join(REPO_DIR, "bin", "desktop-pet")
    if not link_status(BIN_LINK, cli):
        steps.append(("cli", "link %s -> %s" % (BIN_LINK, cli)))
    comp = os.path.join(REPO_DIR, "completions", "desktop-pet.bash")
    if not link_status(COMP_LINK, comp):
        steps.append(("completion", "link bash completion %s" % COMP_LINK))
    if os.path.isfile(HYPR_LUA):
        if not has_block(HYPR_LUA):
            steps.append(("bind-lua", "add SUPER+CTRL+P (toggle pet) to %s (backup first; replaces the default Power-panel binding)" % HYPR_LUA))
    elif os.path.isfile(HYPR_CONF):
        if not has_block(HYPR_CONF):
            steps.append(("bind-conf", "add SUPER+CTRL+P (toggle pet) to %s (backup first)" % HYPR_CONF))
    if shutil_which("kitty") and not kitty_remote_ok() and not has_block(KITTY_CONF):
        steps.append(("kitty", "enable local kitty remote control in %s (backup first; socket-only, private runtime dir)" % KITTY_CONF))
    if not os.path.isfile(CONFIG):
        steps.append(("config", "create default settings %s" % CONFIG))
    if buddy:
        if os.path.isfile(BASHRC) and not has_block(BASHRC):
            steps.append(("buddy-bash", "build buddy: source the shell hook from %s (backup first; logs only command name, exit code, duration)" % BASHRC))
        if os.path.isfile(ZSHRC) and not has_block(ZSHRC):
            steps.append(("buddy-zsh", "build buddy: source the shell hook from %s (backup first)" % ZSHRC))
    return steps


def shutil_which(name):
    for d in os.environ.get("PATH", "").split(":"):
        p = os.path.join(d, name)
        if d and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def cmd_setup(args):
    yes = "-y" in args or "--yes" in args
    buddy = "--buddy" in args
    if not buddy and not yes and sys.stdin.isatty() and not any(has_block(p) for p in (BASHRC, ZSHRC)):
        try:
            buddy = input("Also install the optional build-buddy shell hook (the pet reacts to failed/passed "
                          "commands; records only the command name, exit code and duration)? [y/N] ").strip().lower() in ("y", "yes")
        except EOFError:
            buddy = False
    steps = setup_plan(buddy)
    print(acc("desktop-pet setup") + dim("  (only touches files in your home directory)"))
    if kitty_remote_ok():
        print(dim("  kitty remote control: already enabled, kitty.conf will not be changed"))
    if not shutil_which("kitty"):
        print(dim("  kitty not found: letter-eating needs kitty; the pet will snack on berries instead"))
    if not steps:
        print(acc("✓") + " everything is already set up")
        return 0
    for _, text in steps:
        print("  • " + text)
    if not yes:
        if not sys.stdin.isatty():
            err("not a terminal; re-run with -y to apply")
            return 1
        try:
            ans = input("Apply these changes? [Y/n] ").strip().lower()
        except EOFError:
            ans = "n"
        if ans not in ("", "y", "yes"):
            print("cancelled, nothing changed")
            return 1
    for key, _ in steps:
        if key == "cli":
            os.makedirs(os.path.dirname(BIN_LINK), exist_ok=True)
            if os.path.exists(BIN_LINK) and not os.path.islink(BIN_LINK):
                backup(BIN_LINK)
            if os.path.lexists(BIN_LINK):
                os.remove(BIN_LINK)
            os.symlink(os.path.join(REPO_DIR, "bin", "desktop-pet"), BIN_LINK)
        elif key == "completion":
            os.makedirs(os.path.dirname(COMP_LINK), exist_ok=True)
            if os.path.lexists(COMP_LINK):
                os.remove(COMP_LINK)
            os.symlink(os.path.join(REPO_DIR, "completions", "desktop-pet.bash"), COMP_LINK)
        elif key in ("bind-lua", "bind-conf"):
            path = HYPR_LUA if key == "bind-lua" else HYPR_CONF
            b = backup(path)
            with open(path, "a") as f:
                f.write(LUA_BLOCK if key == "bind-lua" else CONF_BLOCK)
            if not hypr_reload_ok():
                with open(b) as src, open(path, "w") as dst:
                    dst.write(src.read())
                hypr_reload_ok()
                err("Hyprland reported config errors; the keybinding change was reverted (backup: %s)" % b)
        elif key == "kitty":
            os.makedirs(os.path.dirname(KITTY_CONF), exist_ok=True)
            backup(KITTY_CONF)
            with open(KITTY_CONF, "a") as f:
                f.write(KITTY_BLOCK)
        elif key == "config":
            save_config(json.loads(json.dumps(DEFAULTS)))
        elif key in ("buddy-bash", "buddy-zsh"):
            path = BASHRC if key == "buddy-bash" else ZSHRC
            backup(path)
            with open(path, "a") as f:
                f.write(buddy_block("bash" if key == "buddy-bash" else "zsh"))
        print(acc("✓") + " " + dict(steps)[key])
    if any(k.startswith("buddy") for k, _ in steps):
        print(dim("  build buddy works in new terminals; remove it any time with: desktop-pet uninstall"))
    if any(k == "kitty" for k, _ in steps):
        print(dim("  reopen your kitty windows (and btop) so they pick up remote control"))
    if ":%s:" % os.path.join(HOME, ".local/bin") not in ":%s:" % os.environ.get("PATH", ""):
        print(dim("  note: ~/.local/bin is not on your PATH; add it to run 'desktop-pet' by name"))
    if not is_on():
        print(dim("  the pet is off; run: desktop-pet on"))
    return 0


def cmd_uninstall(args):
    purge = "--purge" in args
    print(acc("desktop-pet uninstall"))
    if is_on():
        host_set_enabled(False)
        print(acc("✓") + " pet turned off")
    r = helper("restore-all")
    if r.get("dock"):
        print(acc("✓") + " dock icons restored")
    if r.get("wallpaper"):
        print(acc("✓") + " wallpaper restored")
    for link in (BIN_LINK, COMP_LINK):
        if os.path.islink(link) and os.path.realpath(link).startswith(REPO_DIR):
            os.remove(link)
            print(acc("✓") + " removed " + link)
    for path in (HYPR_LUA, HYPR_CONF):
        if strip_block(path):
            hypr_reload_ok()
            print(acc("✓") + " removed the SUPER+CTRL+P binding from " + path)
    if strip_block(KITTY_CONF):
        print(acc("✓") + " removed the remote-control lines from " + KITTY_CONF)
    for rc in (BASHRC, ZSHRC):
        if strip_block(rc):
            print(acc("✓") + " removed the build-buddy hook from " + rc)
    if purge:
        import shutil
        shutil.rmtree(os.path.dirname(CONFIG), ignore_errors=True)
        shutil.rmtree(STATE_DIR, ignore_errors=True)
        print(acc("✓") + " deleted settings and state")
    else:
        print(dim("  kept settings (%s) and state (%s); use --purge to delete" % (CONFIG, STATE_DIR)))
    print(dim("  to remove the plugin itself: omarchy plugin remove %s" % PLUGIN_ID))
    return 0


HELP = """{title} — a tiny pixel pet for your Omarchy desktop

{u}
  desktop-pet                    show status (pet, stats, accessory)
  desktop-pet <command> [args]

  Mouse: left-click pets it; right-click (or SUPER+SHIFT+left-click) opens its menu.

{c}
  on | off | toggle              show / remove the pet (off removes every overlay
                                 instantly, restores the dock). Key: SUPER+CTRL+P (after setup)
  pick <slime|cat|dragon|goblin> choose your pet (shortcut: desktop-pet cat)
  list                           show all pets with a tiny preview
  name <name>                    name the current pet (shown in its menu)
  feed                           toss a berry treat (no terminal text eaten)
  pet                            pet it (like a left-click)
  heal                           undo everything now: eaten / burned text, skill effects,
                                 dock icons, wallpaper
  wake                           wake the pet up (it sleeps 23:00-07:00)
  accessory <auto|none|NAME>     theme accessory; 'accessory list' shows names
  eat <on|off>                   allow eating letters from your terminal
  goblin-steal <on|off>          allow the goblin to move/hide dock icons
  theme-pet <theme> <pet|off>    optional: use a specific pet on one theme
  size <50|100|200>              pet size in percent (crisp pixel steps)
  color <theme|complement|custom #hex>
                                 theme colors, the opposite hues (stands out), or your own
  poke <hungry|fire|heist>       make it eat / breathe fire / steal right now
  goblin heist-now               make the goblin steal (or return) a dock icon now
  fetch [on|off]                 throw a ball (grab and flick it); on/off allows play
  buddy <on|off>                 react to your terminal commands (needs setup --buddy)
  evolve [--preview]             show the evolution stages and your pet's progress
  evolve --debug-set <stage> [classic|cyber|chonk]   force a stage (testing)
  new [-y]                       start over with a new egg (asks first)
  coffee                         support the project

{k}
  skills                         list skills (built-in, yours, pitched) with on/off
  skills review                  look at what your pet pitched: preview once, approve, reject
  skills enable|disable <id>     turn one skill on or off
  skills on|off                  all skills (off = no skill activity at all)
  skills pitch                   ask your pet to pitch a new skill now (Claude)
  skills run <id>                run a skill once now (preview)
  skills show <id>               what a skill does, step by step, and its recipe
  skills remove <id>             delete one of your skills (built-ins: disable)
  skills sound <on|off>          tiny synthesized skill sounds (default off)
  skills hoard-label <text|off>  a label over the dragon's coin pile
  Recipes: ~/.config/desktop-pet/skills/*.json (format: docs/SKILLS.md)

{b}
  say "<message>"                talk to your pet; reply prints here and in its bubble
  chat                           interactive chat (Ctrl-D to exit)
  brain <on|off>                 off = canned lines only, zero Claude calls
  brain context <on|off>         also share the focused window title (default off)
  chatty <off|low|normal|high>   how often it talks on its own (default low)
  persona "<text>" | reset       override the pet's personality
  forget                         clear its short memory of recent events

{s}
  setup [-y] [--buddy]           link the CLI + completion, add the SUPER+CTRL+P
                                 keybinding and kitty remote control (explains first);
                                 --buddy also installs the build-buddy shell hook
  uninstall [--purge]            undo setup, turn the pet off, restore the dock and wallpaper
  config                         print config path and current settings
  reset [-y]                     restore default settings (asks first)
  help                           this help

{p}
  The brain uses your Claude Code CLI (model haiku) with all tools disabled; the
  reply is shown as plain text only. Sent: the pet's name, stats, mood, time,
  theme and recent pet events (incl. the few letters it ate). Never sent:
  window titles, clipboard or terminal contents, unless 'brain context on'.

{e}
  desktop-pet dragon             switch to the baby dragon
  desktop-pet name Sir Crunch    give it a name
  desktop-pet accessory crown    wear a crown on every theme
  desktop-pet eat off            keep the pet, protect your terminal
  desktop-pet say "good morning!"
  desktop-pet off                hide everything

Settings: ~/.config/desktop-pet/config.json (live-reloaded)
State:    ~/.local/state/desktop-pet/ (stats, memory, dock backup)"""


def cmd_help(_args):
    print(HELP.format(title=acc("desktop-pet"), u=acc("Usage"), c=acc("Pet"), k=acc("Skills"), b=acc("Brain (Claude)"),
                      s=acc("Settings"), p=acc("Privacy"), e=acc("Examples")))
    return 0


COMMANDS = {
    "status": cmd_status, "on": cmd_on, "off": cmd_off, "toggle": cmd_toggle, "pick": cmd_pick,
    "list": cmd_list, "name": cmd_name, "feed": cmd_feed, "pet": cmd_pet, "heal": cmd_heal, "accessory": cmd_accessory,
    "eat": cmd_eat, "goblin-steal": cmd_goblin_steal, "chatty": cmd_chatty, "brain": cmd_brain,
    "persona": cmd_persona, "theme-pet": cmd_theme_pet, "say": cmd_say, "chat": cmd_chat,
    "forget": cmd_forget, "config": cmd_config, "reset": cmd_reset, "help": cmd_help, "wake": cmd_wake,
    "poke": cmd_poke, "size": cmd_size, "color": cmd_color, "fetch": cmd_fetch, "buddy": cmd_buddy,
    "evolve": cmd_evolve, "skills": cmd_skills, "skill": cmd_skills, "new": cmd_new, "coffee": cmd_coffee, "goblin-cmd": cmd_goblin, "setup": cmd_setup, "uninstall": cmd_uninstall,
}


def main(argv):
    if not argv:
        return cmd_status([])
    cmd = argv[0].lower()
    if cmd in ("-h", "--help"):
        return cmd_help([])
    if cmd == "goblin" and len(argv) > 1:
        return cmd_goblin(argv[1:])
    if cmd in PETS:
        return cmd_pick([cmd])
    fn = COMMANDS.get(cmd)
    if not fn:
        err("unknown command '%s'. Pets: %s. Run 'desktop-pet help'." % (argv[0], ", ".join(PETS)))
        return 2
    return fn(argv[1:]) or 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
